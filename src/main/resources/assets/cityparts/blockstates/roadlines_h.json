{
    "multipart": [
        {
            "apply": {
                "model": "cityparts:block/asphalt"
            }
        },
        {
            "when": {
                "facing": "north"
            },
            "apply": {
                "model": "cityparts:block/roadlines_h"
            }
        },
        {
            "when": {
                "facing": "south"
            },
            "apply": {
                "model": "cityparts:block/roadlines_h",
                "y": 180
            }
        },
        {
            "when": {
                "facing": "west"
            },
            "apply": {
                "model": "cityparts:block/roadlines_h",
                "y": 270
            }
        },
        {
            "when": {
                "facing": "east"
            },
            "apply": {
                "model": "cityparts:block/roadlines_h",
                "y": 90
            }
        }
    ]
}