{
  "multipart": [
    {
      "apply": {
        "model": "cityparts:block/tape_post"
      },
      "when": {
        "post": "true"
      }
    },
    {
      "apply": {
        "model": "cityparts:block/caution_tape"
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "cityparts:block/caution_tape",
        "y": 90
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "cityparts:block/caution_tape",
        "y": 180
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "cityparts:block/caution_tape",
        "y": 270
      },
      "when": {
        "west": "true"
      }
    }
  ]
}
